# App
NODE_ENV=development
SERVER_PORT=3000
SERVER_PORT_MACHINE=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_PORT_MACHINE=5432
DB_USER=scribe
DB_PASSWORD=scribe_secret
DB_DATABASE=scribe

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PORT_MACHINE=6379

# JWT
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_refresh
AUTH_EXPIRESIN=15m
AUTH_REFRESH_EXPIRESIN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Anthropic
ANTHROPIC_API_KEY=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Notiscope
NOTISCOPE_BASE_URL=http://localhost:8000
NOTISCOPE_FROM_EMAIL=noreply@yourdomain.com

# AWS (used by Notiscope sidecar)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3001
